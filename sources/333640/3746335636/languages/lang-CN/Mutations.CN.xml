                    <p>最多 10 回合内，你与一名对手进行灵能战斗，每回合造成伤害。</p>
                    <p>采取跳过回合以外的任何行动都会中断连接。</p>
                    <p>每回合你进行一次心灵攻击，对抗心灵护甲（MA）。</p>
                    <statline Name="DamageIncrement" DisplayName="伤害增量" />
                    <p>第十回合后，你造成等于至今已造成伤害总量的额外伤害。</p>
                    <statline Name="Range" DisplayName="射程" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Syphon Vim" DisplayName="汲取活力" BearerDescription="生命蛭" BiomeEpithet="屠戮场">
      <description>
                    <p>你与附近有机生物建立连结，并吸取其生命力。</p>
                </description>
      <leveltext>
                    <p>对有机生物的心灵攻击</p>
                    <p>每回合吸取 <stat Name="HP" Unit="生命值" /></p>
                    <p>目标每回合获得一次心灵豁免以抵抗伤害</p>
                    <statline Name="Duration" DisplayName="持续时间" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Telepathy" DisplayName="心灵感应" BearerDescription="心灵感应者" BiomeAdjective="心灵感应的">
      <description>
                    <p>你可以通过心灵以太与他人交流。</p>
                    <br />
                    <p>与视野内任何人交谈</p>
                    <p>你向同伴下达命令所需时间大幅减少</p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Teleportation" DisplayName="传送" BearerDescription="传送者" BiomeEpithet="时空喀斯特">
      <description>
                    <p>你传送到附近地点。</p>
                </description>
      <leveltext>
                    <p>传送到指定区域内的随机地点。</p>
                    <statline Name="UncertaintyRadius" DisplayName="不确定半径" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Teleport Other" DisplayName="传送他者" BearerDescription="传送他人者" BiomeEpithet="隐修地">
      <description>
                    <p>你将相邻生物传送到附近随机地点。</p>
                </description>
      <leveltext>
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Time Dilation" DisplayName="时间膨胀" BearerDescription="时间膨胀者" BiomeEpithet="时间棱镜">
      <description>
                    <p>你扭曲自己周围的时间，减缓敌人。</p>
                </description>
      <leveltext>
                    <p><stat Name="Range" /> 格内的生物会根据其与你的距离被减速。</p>
                    <p>距离 1：生物受到 <stat Name="QuicknessPenalty1" />% 迅捷惩罚</p>
                    <p>距离 4：生物受到 <stat Name="QuicknessPenalty4" />% 迅捷惩罚</p>
                    <p>距离 7：生物受到 <stat Name="QuicknessPenalty7" />% 迅捷惩罚</p>
                    <statline Name="Duration" DisplayName="持续时间" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Temporal Fugue" DisplayName="时间赋格" BearerDescription="时间逃逸者" BiomeEpithet="时空枢纽">
      <description>
                    <p>你快速来回穿越时间，创造出多个自己的复制体。</p>
                </description>
      <leveltext>
                    <statline Name="Duration" DisplayName="持续时间" />
                    <statline Name="Copies" DisplayName="复制体" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
