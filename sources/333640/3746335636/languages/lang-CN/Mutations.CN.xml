                        <default></default>
                    </switch>
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Slime Glands" DisplayName="黏液腺" BearerDescription="吐黏液者">
      <description>
                    <p>你能产生一种黏稠黏液，并把它吐向物体。</p>
                    <br />
                    <p>用黏液覆盖一片区域</p>
                    <statline Name="Range" DisplayName="射程" />
                    <statline Name="Area" DisplayName="范围" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                    <p>你可以在黏液上行走而不打滑。</p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Spinnerets" DisplayName="吐丝器" BearerDescription="织网者">
      <description>
                    <p>你可以纺出黏性的丝网。</p>
                </description>
      <leveltext>
                    <p>纺丝期间，你移动时会在身后留下网。</p>
                    <switch Name="LevelMatch">
                        <case Value="true"></case>
                        <default><p>{{rules|提高网强度}}</p></default>
                    </switch>
                    <statline Name="SpinDuration" DisplayName="持续时间" Unit="移动动作" />
                    <saveline Name="MoveSave" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                    <p>你免疫被黏住。</p>
                    <p>与 {{w|arachnids}} 的声望 +300</p>
                </leveltext>
    </mutation>
    <mutation Name="Stinger (Confusing Venom)" DisplayName="毒刺（混乱毒液）" BearerDescription="刺尖带有混乱毒液者">
      <description>
                    <p>你长着一条带刺的尾巴，可向敌人注入 <stat Name="VenomType" /> 毒液。</p>
                </description>
      <leveltext>
                    <p>近战攻击时有 20% 几率刺击对手（<gametext>=pv=<stat Name="StingerPen" /> =damage=<stat Name="StingerDamage" /></gametext>）</p>
                    <p>毒刺属于长刃，并且只能穿透一次。</p>
                    <p>冲锋或突刺时总会刺击。</p>
                    <p>毒刺在造成伤害时施加毒液（如果毒刺是你的主武器，则只有 20% 几率）。</p>
                    <p>可以使用“刺击”主动能力，以你的毒刺攻击并自动命中和穿透。</p>
                    <statline Name="Cooldown" DisplayName="刺击冷却" />
                    <p>毒液使对手混乱，持续 <stat Name="Duration" /></p>
                    <p>与 {{w|arachnids}} 的声望 +200</p>
                </leveltext>
    </mutation>
