<mutations Lang="CN" Encoding="utf-8">
  <category Name="Morphotypes" DisplayName="{{W|形态型}}">
    <mutation Name="Chimera" DisplayName="奇美拉">
      <description>
                    <p>你只会显现物理突变，并且在显现新突变时，你的所有突变选项都是物理突变。</p>
                    <br />
                    <p>每当你显现新突变时，其中一个选项还会使你随机长出一条新肢体。</p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Esper" DisplayName="心灵术士">
      <description>
                    <p>你只会显现心灵突变，并且在显现新突变时，你的所有突变选项都是心灵突变。</p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Unstable Genome" DisplayName="不稳定基因组">
      <description>
                    <p>每次购买此项时，你获得一个额外突变，但这些突变不会立刻显现。</p>
                    <p>每当你提升等级时，有 33% 几率使你的基因组失稳，并可从 3 个随机突变中选择。</p>
                </description>
      <leveltext></leveltext>
    </mutation>
  </category>
  <category Name="Physical" DisplayName="{{G|物理突变}}">
    <mutation Name="Adrenal Control" DisplayName="肾上腺控制" BearerDescription="能控制肾上腺的人">
      <description>
                    <p>你能调节身体释放肾上腺素。</p>
                </description>
      <leveltext>
                    <p>你可以在 <stat Name="Duration" /> 内增加身体的肾上腺素流量。</p>
                    <p>流量持续期间，你获得 +<stat Name="QuicknessBonus" /> 迅捷，其他物理突变获得 +<stat Name="MutationBonus" Unit="阶" />。</p>
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Beak" DisplayName="喙" BearerDescription="有喙者">
      <description>
                    <p>你的脸上长着一只悦目的 <stat Name="BeakName" />。</p>
                    <br />
                    <p>+1 Ego</p>
                    <p>你偶尔会啄击对手。</p>
                    <p><gametext>与 {{w|=faction:Birds=}} 的声望 +200</gametext></p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Burrowing Claws" DisplayName="掘穴爪" BearerDescription="掘穴者">
      <description>
                    <!-- code will prefix this with "Burrowing Claws Claw" blueprints VariantDescription -->
                    <p>你长着铲状利爪，可以掘穿泥土。</p>
                </description>
      <leveltext>
                    <p><gametext>=weapon.Name=</gametext> 对墙穿透：<stat Name="WallPenetration" /></p>
                    <p><gametext>=weapon.Name|pluralize=</gametext> 在 <stat Name="WallHits" Unit="穿透命中" /> 后摧毁墙体。</p>
                    <switch Name="PrereleaseContent"><case Value="true"><p>脱离战斗时可以向上或向下挖掘通道</p></case></switch>
                    <p><gametext>=weapon.Name|pluralize= 也是 =weaponClass.name= 类天然武器，对非墙体造成 <stat Name="Damage" /> 基础伤害。</gametext></p>
                </leveltext>
    </mutation>
    <mutation Name="Carapace" DisplayName="甲壳" BearerDescription="披甲壳者">
      <description>
                    <!-- code will prefix this with blueprints VariantDescription -->
                    <p>你受到耐久甲壳的保护。</p>
                </description>
      <leveltext>
                    <p><stat Name="AV" Filters="signed" /> AV</p>
                    <p><stat Name="DV" Filters="signed" /> DV</p>
                    <p><stat Name="HeatResist" Filters="signed" /> 热抗性</p>
                    <p><stat Name="ColdResist" Filters="signed" /> 冷抗性</p>
                    <switch Name="AddsRep"><case Value="" /><default><p><stat Name="AddsRep" /></p></default></switch>
                    <p>只要你保持静止，就可以收紧你的 <stat Name="CarapaceName" />，以 -2 DV 为代价获得双倍 AV 加值。</p>
                    <p>不能穿戴身体护甲。</p>
                </leveltext>
    </mutation>
    <mutation Name="Corrosive Gas Generation" DisplayName="腐蚀气体生成" BearerDescription="排出腐蚀气体者">
      <description>
                    <p>你在自己周围释放一阵 <stat Name="GasName" />。</p>
                </description>
      <leveltext>
                    <p>释放气体，持续 <stat Name="Duration" /></p>
                    <switch Name="LevelMatch">
                        <case Value="raise"><p>{{rules|提高 <stat Name="LevelEffectDescription" />}}</p></case>
                        <case Value="lower"><p>{{rules|降低 <stat Name="LevelEffectDescription" />}}</p></case>
                    </switch>
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Double-muscled" DisplayName="双重肌肉" BearerDescription="双重肌肉者">
      <description>
                    <p>你拥有魁伟巨力。</p>
                </description>
      <leveltext>
                    <p>+<stat Name="Strength" /> 力量</p>
                    <p>近战攻击成功时有 <stat Name="DazeChance" />% 几率使对手眩晕 2-3 回合</p>
                </leveltext>
    </mutation>
    <mutation Name="Electrical Generation" DisplayName="电力生成" BearerDescription="发电者">
      <description>
                    <p>你积累可使用和释放来造成伤害的电荷。</p>
                </description>
      <leveltext>
                    <p>最大电荷：<stat Name="MaxCharge" /></p>
                    <p>每回合基础积累 <stat Name="BaseChargePerTurn" /> 电荷</p>
                    <p>可以释放所有持有电荷，每 <stat Name="DischargeChunk" /> 电荷造成 1d4 伤害</p>
                    <p>放电可以电弧跳转到相邻目标，造成降低后的伤害，每 <stat Name="DischargeChunk" /> 电荷最多影响 1 个目标</p>
                    <p>EMP 会导致非自愿放电（难度 18 意志豁免）</p>
                    <switch Name="CanDrinkTransient">
                        <case Value="true"><p>你可以从电力来源饮取电荷。</p></case>
                        <default><p>你可以从能量电池和电容器饮取电荷。</p></default>
                    </switch>
                    <p>你每承受 1 点电击伤害，就获得 <stat Name="DamageAbsorbFactor" /> 电荷。</p>
                    <p>你可以为已装备且拥有集成供电系统的装置供电。</p>
                </leveltext>
    </mutation>
    <mutation Name="Electromagnetic Pulse" DisplayName="电磁脉冲" BearerDescription="发出电磁脉冲者">
      <description>
                    <p>你生成电磁脉冲，使附近的神器和机器失效。</p>
                </description>
      <leveltext>
                    <p>范围：以你为中心的 <stat Name="Area" /></p>
                    <statline Name="Duration" DisplayName="持续时间" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Flaming Ray" DisplayName="火焰射线" BearerDescription="燃焰之手">
      <description>
                    <p>你<switch Name="BodyPartName"><case Value="" /><default>从你的 <stat Name="BodyPartName" /></default></switch>发射一道火焰射线。</p>
                </description>
      <leveltext>
                    <p>向你选择的方向发射一道 <stat Name="Range" /> 格长的火焰射线。</p>
                    <statline Name="Damage" DisplayName="伤害" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                    <p>近战攻击使对手升温 <stat Name="HeatOnHit" Unit="度" /></p>
                </leveltext>
    </mutation>
    <mutation Name="Freezing Ray" DisplayName="冰冻射线" BearerDescription="冰寒之手">
      <description>
                    <p>你<switch Name="BodyPartName"><case Value="" /><default>从你的 <stat Name="BodyPartName" /></default></switch>发射一道寒霜射线。</p>
                </description>
      <leveltext>
                    <p>向你选择的方向发射一道 <stat Name="Range" /> 格长的寒霜射线。</p>
                    <statline Name="Damage" DisplayName="伤害" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                    <p>近战攻击使对手降温 <stat Name="CoolOnHit" Unit="度" /></p>
                </leveltext>
    </mutation>
    <mutation Name="Heightened Hearing" DisplayName="强化听觉" BearerDescription="听觉强化者">
      <description>
                    <p>你拥有超乎自然的敏锐听觉。</p>
                </description>
      <leveltext>
                    <p>你能探测半径 <stat Name="Radius" /> 内的生物存在。</p>
                    <switch Name="LevelMatch">
                        <case Value="true"><p>有几率识别附近探测到的生物</p></case>
                        <default><p>{{rules|提高识别附近探测到的生物的几率}}</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Heightened Quickness" DisplayName="强化迅捷" BearerDescription="迅捷者">
      <description>
                    <p>你天赋惊人的速度。</p>
                </description>
      <leveltext>
                    <p>+<stat Name="SpeedBonus" /> 迅捷</p>
                </leveltext>
    </mutation>
    <mutation Name="Horns" DisplayName="角" BearerDescription="有角者">
      <description>
                    <p><gametext>=horns.A.name.or.plural= 从你的头上 =horns.verb:jut= 出来。</gametext></p>
                </description>
      <leveltext>
                    <p>近战攻击时有 20% 几率顶刺对手</p>
                    <statline Name="Damage" DisplayName="伤害增量" />
                    <statline Name="ToHitBonus" DisplayName="命中加值" />
                    <switch Name="LevelMode">
                        <case Value="BleedBonus"><p>{{rules|提高流血豁免难度和强度}}</p></case>
                        <case Value="LevelUp"><p>{{rules|提高流血豁免难度}}</p></case>
                        <default><p>顶刺攻击可能造成流血</p></default>
                    </switch>
                    <p><gametext>=horns.Name= =horns.verb:are= 短刃类天然武器。</gametext></p>
                    <p>+<stat Name="AV" /> AV</p>
                    <p>不能戴头盔</p>
                    <p><gametext>与 {{w|=faction:Antelopes=}} 和 {{w|=faction:Goatfolk=}} 的声望 +100</gametext></p>
                </leveltext>
    </mutation>
    <mutation Name="Metamorphosis" DisplayName="变形" BearerDescription="变形者">
      <description>
                    <p>你化为任何你触碰到的生物的形态。</p>
                </description>
      <leveltext>
                    <p>只能化为等级 <stat Name="MaxLevel" /> 或更低的生物。</p>
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Multiple Arms" DisplayName="多臂" BearerDescription="多臂者">
      <description>
                    <p>你拥有额外一组手臂。</p>
                </description>
      <leveltext>
                    <p>每当你进行近战攻击时，每条额外手臂都有 <stat Name="AttackChance" />% 几率发动一次额外近战攻击</p>
                </leveltext>
    </mutation>
    <mutation Name="Multiple Legs" DisplayName="多腿" BearerDescription="多腿者">
      <description>
                    <p>你拥有额外一组腿。</p>
                </description>
      <leveltext>
                    <p>+<stat Name="MoveSpeed" /> 移动速度</p>
                    <p>+<stat Name="CarryCapacity" />% 负重能力</p>
                </leveltext>
    </mutation>
    <mutation Name="Night Vision" DisplayName="夜视" BearerDescription="暗视者">
      <description>
                    <p>你能在黑暗中视物。</p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Phasing" DisplayName="相位化" BearerDescription="相位化者">
      <description>
                    <p>你可以短时间穿过固体物体。</p>
                </description>
      <leveltext>
                    <statline Name="Duration" DisplayName="持续时间" />
                    <statline Name="Cooldown" DisplayName="冷却" />
                </leveltext>
    </mutation>
    <mutation Name="Photosynthetic Skin" DisplayName="光合皮肤" BearerDescription="绿肤者">
      <description>
                    <p>你通过强健的绿色皮肤吸收阳光来补充自己。</p>
                </description>
      <leveltext>
                    <p>你可以沐浴阳光来代替进餐，获得一种持续 <stat Name="DurationDay" Unit="天" /> 的特殊代谢效果：自然治疗速率 +<stat Name="BonusRegen" />，迅捷 +<stat Name="BonusQuickness" /></p>
                    <p>处于阳光下时，你会积累淀粉和木质素，可作为你烹饪餐食的食材（每种最多 <stat Name="StarchServings" Unit="份" />）。</p>
                    <p>与叶丛占据同一空间时，+<stat Name="BonusCamoflage" /> DV</p>
                    <p>与 {{w|roots}}、{{w|trees}}、{{w|vines}} 和 {{w|the Consortium of Phyta}} 的声望 +200</p>
                </leveltext>
    </mutation>
    <mutation Name="Quills" DisplayName="棘刺" BearerDescription="长棘者">
      <description>
                    <!-- description will be replaced with the Quill Blueprint VariantDescription if it has one. -->
                    <p>数百根针尖般的棘刺覆盖你的身体。</p>
                </description>
      <leveltext>
                    <switch Name="LevelMatch">
                        <case Value="true"><p><stat Name="MaxQuills" /> <stat Name="Quills" /></p></case>
                        <default><p>+{{rules|80-120}} <stat Name="Quills" /></p></default>
                    </switch>
                    <p>可以向自己周围爆发射出 10% 的 <stat Name="Quills" />（<gametext>=pv=<stat Name="QuillPen" /> =damage=<stat Name="QuillDamage" /></gametext>）</p>
                    <p>以每回合约 <stat Name="RegenRate" /> 的速率再生 <stat Name="Quills" /></p>
                    <p>只要你保留一半 <stat Name="Quills" />，+<stat Name="AV" /> AV（否则 +<stat Name="AVWithPenalty" /> AV）</p>
                    <p>近战攻击你的生物可能被你的 <stat Name="Quills" /> 扎穿，折断其中约 1%，并按每根折断的 <stat Name="Quill" /> 反射 3% 伤害。</p>
                    <p>不能穿戴身体护甲</p>
                    <p>免疫其他生物的 <stat Name="Quills" /></p>
                </leveltext>
    </mutation>
    <mutation Name="Regeneration" DisplayName="再生" BearerDescription="再生者">
      <description>
                    <p>你的伤口愈合得非常快。</p>
                </description>
      <leveltext>
                    <p>你的完整自然治疗速率在战斗中也会生效。</p>
                    <p>自然治疗速率加快 +<stat Name="RegenBonus" />%</p>
                    <p>每回合有 <stat Name="RegenChance" />% 几率再生一条缺失肢体</p>
                    <switch Name="NoDecapitate">
                        <case Value="false" />
                        <default><p>{{rules|你不会被斩首。}}</p></default>
                    </switch>
                    <switch Name="LevelBelow5">
                        <case Value="true"><p>每回合有 <stat Name="DebuffChance" />% 几率随机移除一个{{rules|轻微物理减益}}</p></case>
                        <default><p>每回合有 <stat Name="DebuffChance" />% 几率随机移除一个{{rules|物理减益}}</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Sleep Gas Generation" DisplayName="睡眠气体生成" BearerDescription="排出睡眠气体者">
      <description>
                    <p>你在自己周围释放一阵 <stat Name="GasName" />。</p>
                </description>
      <leveltext>
                    <p>释放气体，持续 <stat Name="Duration" /></p>
                    <switch Name="LevelMatch">
                        <case Value="raise"><p>{{rules|提高 <stat Name="LevelEffectDescription" />}}</p></case>
