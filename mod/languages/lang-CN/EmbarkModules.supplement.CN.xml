<?xml version='1.0' encoding='utf-8'?>
<embarkmodules Lang="CN" Encoding="utf-8">
  <module Class="XRL.CharacterBuilds.Qud.QudGamemodeModule">
    <modes>
      <mode ID="Tutorial">
        <description>
          学习《库德洞窟》的基础。
              </description>
      </mode>
      <mode ID="Wander">
        <description>
          {{c|∙}} 大多数生物一开始对你中立。
          {{c|∙}} 杀戮不提供 经验。
          {{c|∙}} 发现事物和执行水仪式可获得更多 经验。
          {{c|∙}} 在定居点设置检查点。
              </description>
      </mode>
    </modes>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudPregenModule">
    <pregens>
      <pregen ID="bzzzt" Name="滋滋滋" />
    </pregens>
  </module>
  <module Class="XRL.CharacterBuilds.Qud.QudChooseStartingLocationModule">
    <locations>
      <location ID="Joppa" Name="{{Y|约帕(约帕)}}" />
      <location ID="SaltMarshVillage">
        <description>
          {{c|∙}} 盐沼中的随机村庄。
          {{c|∙}} 村庄教授收割术。
          {{c|∙}} 在昆虫和鱼类中的声望 +50。
          {{c|∙}} 开局拥有一双 {{g|鳄皮{{G|软}}鞋}}。
              </description>
      </location>
      <location ID="SaltDuneVillage">
        <description>
          {{c|∙}} 盐丘中的随机村庄。
          {{c|∙}} 村庄教授斋戒之道。
          {{c|∙}} 在爬行动物中的声望 +100。
          {{c|∙}} 开局拥有一面 {{Y|伊萨{{r|查}}里}} 旗帜。
              </description>
      </location>
      <location ID="JoppaTutorial">
        <description>
          你抵达 库德 的边缘。
              </description>
      </location>
    </locations>
  </module>
</embarkmodules>