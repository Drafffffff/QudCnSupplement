  <object Name="FungusPuffer1" Load="Merge">
    <part Name="Render" DisplayName="{{W|孵育金孢 泡菇}}" />
    <part Name="Description" Short="金色菌褶绷紧又松开，绷紧又松开，绷紧又松开，仿佛在把气息吸入 泡菇 的柄中。每一次呼气，它都喷出一团金色孢子，如阳光微尘。它们飘回菌盖，凝成金色浆质。" />
